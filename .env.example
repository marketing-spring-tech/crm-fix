# HubSpot private app token. Scopes: crm.objects.contacts.read, crm.objects.contacts.write,
# crm.schemas.contacts.read, crm.schemas.contacts.write (+ behavioral_events.event_definitions.read_write
# and analytics.behavioral_events.send if HUBSPOT_CUSTOM_EVENTS=true)
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx

# Shared secret PostHog sends as "Authorization: Bearer <secret>" to the webhook
WEBHOOK_SECRET=change-me

# Optional: also send HubSpot custom behavioral events (Marketing Hub Enterprise only).
# Map of PostHog event -> HubSpot event internal name lives in config/events.json (hubspotEventName).
HUBSPOT_CUSTOM_EVENTS=false

# Backfill only: PostHog personal API key with query:read, project id, and host
POSTHOG_PERSONAL_API_KEY=phx_xxxxxxxx
POSTHOG_PROJECT_ID=12345
POSTHOG_HOST=https://eu.posthog.com

PORT=8080
EVENTS_CONFIG=config/events.json
