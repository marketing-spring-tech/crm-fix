# HubSpot private app token. Scopes: crm.objects.contacts.read, crm.objects.contacts.write,
# crm.schemas.contacts.read, crm.schemas.contacts.write
# (+ analytics.behavioral_events.send if HUBSPOT_CUSTOM_EVENTS=true, Marketing Hub Enterprise only)
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx

# Mixpanel service account (Organization settings -> Service accounts), role Analyst or higher on the project
MIXPANEL_SERVICE_ACCOUNT_USERNAME=sync.xxxxxx.mp-service-account
MIXPANEL_SERVICE_ACCOUNT_SECRET=xxxxxxxx
MIXPANEL_PROJECT_ID=1234567
# us | eu | in  (where your project's data is stored)
MIXPANEL_REGION=us

# Poller
POLL_INTERVAL_MINUTES=10
# How many days back each poll re-scans to catch late-arriving events (offline mobile, batch imports)
LOOKBACK_DAYS=2
# Cursor + email cache. Put it on a persistent volume.
STATE_FILE=data/state.json
# false = only update contacts that already exist in HubSpot
CREATE_CONTACTS=true
HUBSPOT_CUSTOM_EVENTS=false

EVENTS_CONFIG=config/events.json
