{
  "name": "mixpanel-hubspot-sync",
  "version": "1.0.0",
  "private": true,
  "description": "Syncs key Mixpanel product events into HubSpot contacts (properties + timeline notes).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --import tsx src/run.ts",
    "sync:once": "node --import tsx src/run.ts --once",
    "setup:hubspot": "node --import tsx src/scripts/setup-properties.ts",
    "backfill": "node --import tsx src/scripts/backfill.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.0"
  }
}
