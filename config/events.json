{
  "$comment": "Mixpanel project 'Spring' (4058092). Each event gets HubSpot contact properties mixpanel_<key>_first_at / _last_at / _count. logNote=true also adds a timeline note (milestones only). Events whose properties match `exclude` are skipped.",
  "events": [
    { "mixpanelEvent": "app_installed", "key": "app_installed", "label": "App installed", "logNote": true },
    { "mixpanelEvent": "account_created", "key": "account_created", "label": "Account created", "logNote": true },
    { "mixpanelEvent": "onboarding_started", "key": "onboarding_started", "label": "Onboarding started" },
    { "mixpanelEvent": "onboarding_first_result_shown", "key": "first_result_shown", "label": "First result shown", "logNote": true },
    { "mixpanelEvent": "onboarding_finished", "key": "onboarding_finished", "label": "Onboarding finished", "logNote": true },
    { "mixpanelEvent": "app_opened", "key": "app_opened", "label": "App opened" },
    { "mixpanelEvent": "project_created", "key": "project_created", "label": "Project created" },
    { "mixpanelEvent": "project_opened", "key": "project_opened", "label": "Project opened" },
    { "mixpanelEvent": "prompt_sent", "key": "prompt_sent", "label": "Prompt sent" },
    { "mixpanelEvent": "change_kept", "key": "change_kept", "label": "Change kept" },
    { "mixpanelEvent": "github_connected", "key": "github_connected", "label": "GitHub connected", "logNote": true },
    { "mixpanelEvent": "connector_connected", "key": "connector_connected", "label": "Connector connected" },
    { "mixpanelEvent": "pr_merged", "key": "pr_merged", "label": "PR merged", "logNote": true },
    { "mixpanelEvent": "share_published", "key": "share_published", "label": "Share published", "logNote": true },
    { "mixpanelEvent": "team_invite_sent", "key": "team_invite_sent", "label": "Teammate invited", "logNote": true },
    { "mixpanelEvent": "team_invite_accepted", "key": "team_invite_accepted", "label": "Team invite accepted", "logNote": true },
    { "mixpanelEvent": "credit_cap_reached", "key": "credit_cap_reached", "label": "Credit cap reached", "logNote": true }
  ],
  "noteProperties": ["signup_method", "signup_source", "source", "platform", "app_version", "credit_balance", "threshold", "visibility", "channel"],
  "exclude": { "is_internal": [true, "true"], "app_env": ["dev"] }
}
